{
    "name": "pi-timer",
    "version": "1.0.0",
    "description": "Pi 与 Codex 扩展 - 终端展示、响应计时、对话记录与会话回退",
    "type": "module",
    "scripts": {
        "test": "node --test tests/*.test.ts .pi/extensions/rewind-claude/*.test.ts",
        "typecheck": "tsc --noEmit && node --check .codex/scripts/codex-conversation-logger.mjs"
    },
    "keywords": ["pi-package"],
    "license": "MIT",
    "pi": {
        "extensions": [
            "./.pi/extensions/claude-style/index.ts",
            "./.pi/extensions/minimal-output.ts",
            "./.pi/extensions/response-timer.ts",
            "./.pi/extensions/conversation-logger.ts",
            "./.pi/extensions/model-thinking-memory.ts",
            "./.pi/extensions/model-collaboration/index.ts",
            "./.pi/extensions/work-profiler",
            "./.pi/extensions/rewind-claude/index.ts"
        ]
    },
    "files": [
        ".codex/hooks.json",
        ".codex/scripts/",
        ".pi/extensions/",
        "package.json"
    ],
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*"
    }
}
