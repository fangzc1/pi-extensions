{
    "name": "pi-timer",
    "version": "1.0.0",
    "description": "Pi 扩展 - 终端展示、响应计时、对话记录与会话回退",
    "type": "module",
    "scripts": {
        "test": "node --test tests/*.test.ts .pi/extensions/rewind-claude/*.test.ts",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "pi-package"
    ],
    "license": "MIT",
    "pi": {
        "extensions": [
            "./.pi/extensions/claude-style/index.ts",
            "./.pi/extensions/custom-status-bar.ts",
            "./.pi/extensions/auto-session-name.ts",
            "./.pi/extensions/response-timer.ts",
            "./.pi/extensions/conversation-logger.ts",
            "./.pi/extensions/model-thinking-memory.ts",
            "./.pi/extensions/model-delegation/index.ts",
            "./.pi/extensions/rewind-claude/index.ts"
        ]
    },
    "files": [
        ".pi/extensions/",
        "package.json"
    ],
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "typescript": "^7.0.2"
    }
}
